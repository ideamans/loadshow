{
  "version": "0.2.0",
  "configurations": [
    // To debug, make sure a *.spec.ts file is active in the editor, then run a configuration
    {
      "type": "node",
      "request": "launch",
      "name": "Debug yarn adhoc",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["adhoc"],
      "port": 9229,
      "outputCapture": "std",
      "skipFiles": ["<node_internals>/**/*.js"],
      "cwd": "${workspaceFolder}"
    }]
}
