{
  "name": "loadshow",
  "version": "1.0.15",
  "type": "module",
  "description": "CLI tool to record a web page loading process as a video file.",
  "main": "build/index.js",
  "typings": "build/index.d.ts",
  "module": "build/index.js",
  "repository": "https://github.com/ideamnas/loadshow",
  "license": "Apache-2.0",
  "keywords": [],
  "scripts": {
    "build": "tsc",
    "fix": "run-s fix:*",
    "fix:lint": "eslint --fix",
    "fix:prettier": "prettier --write src",
    "test": "run-s build test:*",
    "test:lint": "eslint src",
    "test:prettier": "prettier src --list-different",
    "test:cspell": "cspell \"{README.md,.github/*.md,src/**/*.ts}\"",
    "test:unit": "nyc --silent ava build/**/*.test.js",
    "watch": "nyc --silent ava --watch",
    "prepublishOnly": "run-s build",
    "command": "yarn build && node build/command.js",
    "adhoc": "yarn build && node build/adhoc.js"
  },
  "bin": {
    "loadshow": "build/command.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@puppeteer/browsers": "^2.4.0",
    "@types/text-to-svg": "^3.1.4",
    "commander": "^12.1.0",
    "dayjs": "^1.11.13",
    "dot-prop": "^9.0.0",
    "execa": "^9.3.1",
    "handlebars": "^4.7.8",
    "image-size": "^1.1.1",
    "node-html-to-image": "^4.0.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "pretty-bytes": "^5",
    "puppeteer-core": "^22.7.1",
    "sharp": "^0.33.3",
    "text-to-svg": "^3.1.5",
    "tmp-promise": "^3.0.3",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "ava": "^6.1.3",
    "cspell": "^8.14.4",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "get-port": "^7.1.0",
    "npm-run-all": "^4.1.5",
    "nyc": "^17.1.0",
    "prettier": "^3.3.3",
    "standard-version": "^9.5.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "files": [
    "build/",
    "src/"
  ],
  "ava": {
    "failFast": true,
    "timeout": "60s",
    "environmentVariables": {
      "LC_ALL": "en_US.UTF-8",
      "TZ": "UTC"
    },
    "files": [
      "build/**"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "semi": false,
    "printWidth": 120
  }
}